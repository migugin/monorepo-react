{
  "name": "react-apps",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev:gyupt": "pnpm --filter gyupt dev",
    "dev:movie-app": "pnpm --filter movie-app dev",
    "dev:zeplin": "pnpm --filter zeplin-code-extension dev",
    "test:zeplin": "pnpm --filter zeplin-code-extension test",
    "generate:zeplin": "pnpm --filter zeplin-code-extension generate:fixture",
    "fetch:zeplin": "pnpm --filter zeplin-code-extension fetch:screen",
    "start:zeplin": "pnpm --filter zeplin-code-extension start",
    "build": "pnpm -r build",
    "lint": "pnpm -r exec eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0"
  }
}